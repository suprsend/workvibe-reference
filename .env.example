# ─────────────────────────────────────────────────────────────────────────────
# WorkVibe — environment variables
#
# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.
# Every value comes from your SuprSend dashboard (https://app.suprsend.com).
#
# Tip: run `npm run create:workspaces` to create the workspaces in your account
# and fill each Workspace Key here, then paste the remaining keys, then
# `npm run push:assets` to publish the reference assets. See the README
# "Getting started" section.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of this app (http://localhost:3000 in dev).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo password gate. WorkVibe has no login of its own, so a hosted demo must sit
# behind something. Set this on a deployment and the whole app (pages and API)
# requires this one shared password. Leave it EMPTY locally to keep the gate off.
DEMO_PASSWORD=

# ── SuprSend account-wide ────────────────────────────────────────────────────
# Service Token — powers the Management API (workspaces, templates, workflows, categories).
# Account Settings → Service Tokens → create/copy. One token for the whole account.
# (This is NOT the REST "API Key" — that Bearer credential is a different thing
#  the app does not use.)
SUPRSEND_SERVICE_TOKEN=

# API hosts — defaults shown. Override only for a private / region-specific cluster.
SUPRSEND_MGMNT_URL=https://management-api.suprsend.com
SUPRSEND_HOST=https://hub.suprsend.com

# ─────────────────────────────────────────────────────────────────────────────
# PER-WORKSPACE CREDENTIALS
#
# The app lists the workspaces in your SuprSend account and shows every one whose
# Workspace Key below matches it. The env-var prefix is the workspace slug,
# uppercased, dashes → "_":
#
#     slug "workvibe-emberoak"  →  prefix  SUPRSEND_WORKVIBE_EMBEROAK
#                              public   NEXT_PUBLIC_SUPRSEND_WORKVIBE_EMBEROAK
#
# All per-workspace values live in ONE place in the dashboard:
#   <workspace> → Developers → API Keys
#   https://app.suprsend.com/en/<workspace-slug>/developers/api-keys
# ─────────────────────────────────────────────────────────────────────────────

# ── Workspace: workvibe-emberoak ────────────────────────────────────────────────────────────────────────────────────────────
# Workspace Key — auto-filled by `npm run create:workspaces` (it equals the workspace UID,
# which the API returns). Fill by hand only if you skip that script: "Workspace Key and Secret" section.
SUPRSEND_WORKVIBE_EMBEROAK_WORKSPACE_KEY=
# Workspace Secret — same section, the "Secret" value (dashboard-only; no API returns it).
SUPRSEND_WORKVIBE_EMBEROAK_WORKSPACE_SECRET=
# Signing Key UID — "Signing Keys" section, the "Signing Key UID" column (value starts `signing_key_`).
# not the "Signing Key ID" (`ws_signk_…`)
SUPRSEND_WORKVIBE_EMBEROAK_SIGNING_KEY_UID=
# Signing Key (base64) — the ES256 signing private key (PEM), base64-encoded. See README.
SUPRSEND_WORKVIBE_EMBEROAK_SIGNING_KEY_B64=
# Public Key — "Public Keys" section (value starts `SS.PUBK`). Browser inbox SDK. (public)
NEXT_PUBLIC_SUPRSEND_WORKVIBE_EMBEROAK_PUBLIC_KEY=

# ── Workspace: workvibe-nolans ─────────────────────────────────────────────────────────────────────────────────────────
# Workspace Key — auto-filled by `npm run create:workspaces` (it equals the workspace UID,
# which the API returns). Fill by hand only if you skip that script: "Workspace Key and Secret" section.
SUPRSEND_WORKVIBE_NOLANS_WORKSPACE_KEY=
# Workspace Secret — same section, the "Secret" value (dashboard-only; no API returns it).
SUPRSEND_WORKVIBE_NOLANS_WORKSPACE_SECRET=
# Signing Key UID — "Signing Keys" section, the "Signing Key UID" column (value starts `signing_key_`).
# not the "Signing Key ID" (`ws_signk_…`)
SUPRSEND_WORKVIBE_NOLANS_SIGNING_KEY_UID=
# Signing Key (base64) — the ES256 signing private key (PEM), base64-encoded. See README.
SUPRSEND_WORKVIBE_NOLANS_SIGNING_KEY_B64=
# Public Key — "Public Keys" section (value starts `SS.PUBK`). Browser inbox SDK. (public)
NEXT_PUBLIC_SUPRSEND_WORKVIBE_NOLANS_PUBLIC_KEY=
