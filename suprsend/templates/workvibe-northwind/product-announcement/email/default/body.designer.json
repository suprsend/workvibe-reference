         "anchor": "",
         "locked": false,
         "fontSize": "14px",
         "hideable": true,
         "textJson": "{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Thanks for riding with \",\"type\":\"extended-text\",\"version\":1},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"{{$brand.brand_name}}\",\"type\":\"merge_tag\",\"version\":1,\"properties\":{\"name\":\"$brand > brand_name\",\"value\":\"{{$brand.brand_name}}\",\"_meta\":{\"key\":\"$brand.brand_name\",\"tree\":[{\"name\":\"Tenant\",\"_meta\":{\"key\":\"$brand\"}},{\"name\":\"$brand > brand_name\",\"value\":\"{{$brand.brand_name}}\",\"_meta\":{\"key\":\"$brand.brand_name\"}}]}}},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\". Use code {{promo_code}} at checkout and we'll take {{credit_amount}} off your next trip. \",\"type\":\"extended-text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"extended-paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\",\"isInlineTool\":false},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Offer ends {{expires_on}}.\",\"type\":\"extended-text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"extended-paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\",\"isInlineTool\":false}],\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}}",
